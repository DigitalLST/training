<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <style>
  body {
    font-family: "Amiri", serif;
    direction: rtl;
    text-align: right;
    margin: 20px;
    /* ✅ IMPORTANT pour laisser la place au footer fixed */
    padding-bottom: 45mm;
  }
  /* ... ton CSS existant ... */
  /* ✅ Footer signatures CN (miniatures) */
  .cn-footer {
    position: fixed;
    bottom: 8mm;
    left: 12mm;           /* ✅ bas-gauche */
    z-index: 9999;
    display: flex;
    gap: 8mm;
    align-items: flex-end;
    /* en RTL, certains navigateurs inversent; on force LTR pour stable */
    direction: ltr;
  }
  .cn-footer .sig {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
  }
  /* ✅ miniature 1/2 à 1/4 : ajuste ici */
  .cn-footer img {
    width: 45px;          /* ≈ 1/2 - 1/4 de tes 100px */
    height: auto;
    opacity: 0.95;
  }
  /* pas de nom/date : uniquement signatures => on enlève tout texte */
    .header-logo {
      text-align: center;
      margin-bottom: 10px;
    }
    .header-logo img {
      width: 120px;
    }
    .title {
      text-align: center;
      font-size: 22px;
      font-weight: bold;
      margin-bottom: 4px;
    }
    .subtitle {
      text-align: center;
      font-size: 20px;
      font-weight: bold;
      margin-bottom: 2px;
    }
    .sub_subtitle {
      text-align: center;
      font-size: 18px;
      margin-bottom: 2px;
    }
    .section-title {
      font-size: 18px;
      font-weight: bold;
      margin-top: 24px;
      margin-bottom: 8px;
    }
    /* ---------- TABLES GÉNÉRALES (avec header répété) ---------- */
    table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 8px;
      font-size: 12px;
      page-break-inside: auto;
    }
    thead {
      display: table-header-group; /* ✅ répète l’en-tête sur chaque page */
    }
    tfoot {
      display: table-footer-group;
    }
    tr {
      page-break-inside: avoid;    /* ✅ une ligne ne se coupe pas en deux */
      page-break-after: auto;
    }
    th, td {
      border: 1px solid #999;
      padding: 4px 6px;
      text-align: center;
      vertical-align: middle;
    }
    th {
      background-color: #f1f1f1;
      font-weight: bold;
    }
    .signatures-table td {
      border: none;
      text-align: center;
      padding: 10px;
    }
    .signatures-table img {
      width: 100px;
      margin-top: 4px;
    }
    .signatures-table tr {
      page-break-inside: avoid; /* ✅ évite une signature coupée */
    }
    .page-break {
      page-break-before: always;
    }
    .validation {
      margin-top: 10px;
      color: #e20514;
      font-size: 16px;
    }
    /* ---------- BLOCS DE RAPPORT ---------- */
    .report-block-title {
      font-size: 16px;
      font-weight: bold;
      margin-top: 8px;
      margin-bottom: 4px;
    }
    .report-block-text {
      font-size: 13px;              /* un peu plus petit pour gagner de la place */
      border: 1px solid #999;
      padding: 6px;
      border-radius: 6px;
      white-space: pre-wrap;
      line-height: 1.4;             /* interligne resserrée */
      margin-bottom: 6px;
      page-break-inside: auto;      /* le texte peut se couper proprement si très long */
    }
    .report-signature {
      page-break-inside: avoid;     /* signature + nom + date restent ensemble */
      margin-top: 10px;
    }
  </style>
</head>
<body>
  <!-- ✅ FOOTER mini signatures (président + commissaire) -->
<% if ((cnPresident && cnPresident.signatureDataUrl) || (cnCommissioner && cnCommissioner.signatureDataUrl)) { %>
    <div class="cn-footer">
<% if (cnCommissioner && cnCommissioner.signatureDataUrl) { %>
        <div class="sig">
          <img src="<%= cnCommissioner.signatureDataUrl %>" alt="commissioner-signature" />
        </div>
<% } %>
<% if (cnPresident && cnPresident.signatureDataUrl) { %>
        <div class="sig">
          <img src="<%= cnPresident.signatureDataUrl %>" alt="president-signature" />
        </div>
<% } %>
    </div>
<% } %>
  <!-- EN-TÊTE AVEC LOGO -->
  <div class="header-logo">
<% if (logoDataUrl) { %>
      <img src="<%= logoDataUrl %>" />
<% } %>
  </div>
  <!-- ... le reste de ton template inchangé ... -->
  <div class="title"><%= sessionTitle %></div>
  <div class="subtitle"><%= formationTitle %></div>
<% if (centreLine) { %>
    <div class="subtitle"><%= centreLine %></div>
<% } %>
<% if (periodLine) { %>
    <div class="sub_subtitle"><%= periodLine %></div>
<% } %>
<% if (directorName) { %>
    <div class="subtitle">قائد الدراسة : <%= directorName %></div>
<% } %>
  <!-- ✅ 1) STATS GLOBALES (EN PREMIER) -->
  <div class="section-title">إحصائيات عامة</div>
  <table>
    <thead>
      <tr>
        <th>عدد المشاركين</th>
        <th>عدد الحاضرين</th>
        <th> يؤهل</th>
        <th> يعيد الدورة</th>
        <th>  لا يناسب الدور</th>
        <th>نسبة النجاح</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td><%= stats.totalParticipants || 0 %></td>
        <td><%= stats.totalPresent || 0 %></td>
        <td><%= stats.successCount || 0 %></td>
        <td><%= stats.retakeCount || 0 %></td>
        <td><%= stats.incompatibleCount || 0 %></td>
        <td><%= (stats.successPct || 0).toFixed(1) %>%</td>
      </tr>
    </tbody>
  </table>
<% if (validationSentence) { %>
    <div class="validation"><%= validationSentence %></div>
<% } %>
  <!-- ✅ 3) ÉQUIPE DE DIRECTION (inchangé, juste après) -->
  <div class="section-title">قيادة الدراسة</div>
  <table class="signatures-table">
    <tbody>
<% (team || []).forEach(function(m) { %>
<% if (m.role === 'coach') { return; } %>
        <tr>
          <td>
            <div><strong><%= m.roleLabel %></strong></div>
            <div><%= m.prenom || '' %> <%= m.nom || '' %></div>
          </td>
          <td>
<% if (m.lastApprovedAtText) { %>
              <div>تاريخ المصادقة : <%= m.lastApprovedAtText %></div>
<% } %>
          </td>
          <td>
<% if (m.signatureDataUrl) { %>
              <div><img src="<%= m.signatureDataUrl %>" /></div>
<% } %>
          </td>
        </tr>
<% }) %>
    </tbody>
  </table>
<!-- ✅ 2) TABLEAU GLOBAL DES RÉSULTATS (APRÈS STATS) -->
<div class="page-break"></div>
<div class="section-title">النتائج النهائية</div>
<%
  const list = (trainees || []);
  const PER_PAGE = 30;
  // split en chunks de 30
  const chunks = [];
  for (let i = 0; i *<* list.length; i += PER_PAGE) {
    chunks.push(list.slice(i, i + PER_PAGE));
  }
%>
<% chunks.forEach(function(chunk, pageIdx) { %>
<% if (pageIdx > 0) { %>
    <div class="page-break"></div>
    <div class="section-title">النتائج النهائية (تابع)</div>
<% } %>
  <table>
    <thead>
      <tr>
        <th>المعرف الكشفي</th>
        <th>الاسم واللقب</th>
        <th>رقم الهاتف</th>
        <th>الجهة</th>
        <th>البريد الالكتروني</th>
        <th>العدد الممنوح</th>
        <th>النسبة</th>
        <th>القرار</th>
      </tr>
    </thead>
    <tbody>
<% chunk.forEach(function(t) { %>
        <tr>
          <td><%= t.idScout || '—' %></td>
          <td><%= (t.prenom || '') + ' ' + (t.nom || '') %></td>
        <td dir="ltr" style="unicode-bidi:isolate; white-space:nowrap;"><%= t.whatsapp || '—' %></td>
          <td><%= t.region || '—' %></td>
          <td><%= t.email || '—' %></td>
          <td><%= t.totalMax %>/<%= t.totalNote %></td>
          <td><%= (t.pct || 0).toFixed(1) %>%</td>
          <td><%= t.decisionLabel %></td>
        </tr>
<% }) %>
    </tbody>
  </table>
<% }) %>
  <!-- PAGES INDIVIDUELLES PAR STAGIAIRE (inchangé) -->
<% (trainees || []).forEach(function(t, idx) { %>
    <div class="page-break"></div>
    <div class="section-title">
      بطاقة تقييم المتدرب
    </div>
    <div class="sub_subtitle">
      <div>المعرف الكشفي : <%= t.idScout || '—' %></div>
      <div>الاسم و اللقب : <%= t.prenom || '' %> <%= t.nom || '' %></div>
      <div>الجهة : <%= t.region || '—' %></div>
    </div>
    <table>
      <thead>
        <tr>
          <th>مجال التقييم</th>
          <th>عنصر التقييم</th>
          <th>العلامة القصوى</th>
          <th>العلامة</th>
        </tr>
      </thead>
<% if (t.evaluationGroups && t.evaluationGroups.length) { %>
        <tbody>
<% (t.evaluationGroups || []).forEach(function(g) { %>
<% (g.rows || []).forEach(function(r, idxRow) { %>
              <tr>
<% if (idxRow === 0) { %>
                  <td rowspan="<%= g.rows.length %>"><%= g.famille || '' %></td>
<% } %>
                <td><%= r.critere || '' %></td>
                <td><%= r.maxnote || '' %></td>
                <td><%= r.note || '' %></td>
              </tr>
<% }) %>
<% }) %>
        </tbody>
<% } else { %>
        <tbody>
<% (t.evaluationRows || []).forEach(function(r) { %>
            <tr>
              <td><%= r.famille || '' %></td>
              <td><%= r.critere || '' %></td>
              <td><%= r.maxnote || '' %></td>
              <td><%= r.note || '' %></td>
            </tr>
<% }) %>
        </tbody>
<% } %>
    </table>
    <div class="subtitle" style="margin-top: 8px;">
      المجموع : <%= t.totalNote %>/<%= t.totalMax %>
      ( <%= t.pct.toFixed(1) %>% ) – القرار : <%= t.decisionLabel %>
    </div>
    <div class="section-title">قيادة الدراسة</div>
    <table class="signatures-table">
      <tbody>
<% (team || []).forEach(function(m) { %>
<% if (m.role === 'coach') { return; } %>
          <tr>
            <td>
              <div><strong><%= m.roleLabel %></strong></div>
              <div><%= m.prenom || '' %> <%= m.nom || '' %></div>
            </td>
            <td>
<% if (m.lastApprovedAtText) { %>
                <div>تاريخ المصادقة : <%= m.lastApprovedAtText %></div>
<% } %>
            </td>
            <td>
<% if (m.signatureDataUrl) { %>
                <div><img src="<%= m.signatureDataUrl %>" /></div>
<% } %>
            </td>
          </tr>
<% }) %>
      </tbody>
    </table>
<% }) %>
  <!-- 🔹 PAGE RAPPORT DIRECTEUR (inchangé) -->
<% if (directorReport) { %>
    <div class="page-break"></div>
    <div class="section-title">تقرير قائد الدراسة</div>
    <div class="report-block-title">1. ملاحظات حول المتدربين</div>
    <div class="report-block-text">
<%= directorReport.block1 || '' %>
    </div>
    <div class="report-block-title">2. ملاحظات حول قيادة الدراسة</div>
    <div class="report-block-text">
<%= directorReport.block2 || '' %>
    </div>
    <div class="report-block-title">3. ملاحظات عامة وتوصيات</div>
    <div class="report-block-text">
<%= directorReport.block3 || '' %>
    </div>
    <table class="signatures-table report-signature">
      <tbody>
        <tr>
          <td>
            <div><strong>قائد الدراسة</strong></div>
            <div>
<%= (directorReport.prenom || '') + ' ' + (directorReport.nom || '') %>
            </div>
          </td>
          <td>
<% if (directorReport.signedAt) { %>
              <div>
                تاريخ الإمضاء :
<%= new Date(directorReport.signedAt).toLocaleDateString('ar-TN', {
                  year: 'numeric',
                  month: '2-digit',
                  day: '2-digit'
                }) %>
              </div>
<% } else if (directorReport.updatedAt) { %>
              <div>
                آخر تحديث :
<%= new Date(directorReport.updatedAt).toLocaleDateString('ar-TN', {
                  year: 'numeric',
                  month: '2-digit',
                  day: '2-digit'
                }) %>
              </div>
<% } %>
          </td>
          <td>
<% if (directorReport.signatureDataUrl) { %>
              <div><img src="<%= directorReport.signatureDataUrl %>" /></div>
<% } %>
          </td>
        </tr>
      </tbody>
    </table>
<% } %>
</body>
</html>
